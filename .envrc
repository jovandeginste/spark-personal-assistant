# direnv environment for spark-personal-assistant
export GOMODCACHE="$PWD/.gomodcache"
export GOCACHE="$PWD/.gocache"
export GOPATH="$HOME/go"
export GOFLAGS="-mod=mod -tags=goolm"
# Add project bin to PATH
PATH_add "$GOPATH/bin"
# Load flake nix shell when entering the directory (if nix is installed)
if command -v nix >/dev/null 2>&1; then
  use flake
fi
